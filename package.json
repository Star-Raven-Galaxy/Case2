{
  "name": "equipment-maintenance-api",
  "version": "1.0.0",
  "description": "REST API для учёта заявок на обслуживание оборудования",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all"
  },
  "keywords": [
    "express",
    "rest-api",
    "equipment",
    "maintenance"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^5.0.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "sequelize": "^6.37.8",
    "uuid": "^11.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "pino-pretty": "^13.0.0",
    "sequelize-cli": "^6.6.5"
  }
}
